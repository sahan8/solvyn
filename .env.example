# Only variables intentionally exposed to browsers may start with NEXT_PUBLIC_.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment integration placeholders; never commit real secret values.
NEXT_PUBLIC_PAYMENT_PROVIDER_PUBLIC_KEY=
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=

# Authentication/provider placeholders. Never use fallback secrets in production.
AUTH_SECRET=
AUTH_TRUST_HOST=
DATABASE_URL=
AUTH_EMAIL_PROVIDER_API_KEY=
